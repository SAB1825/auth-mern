
{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "target" : "ES6",
    "module": "commonjs",
    "strict": "true",
    "skipLibCheck": "true",
    "removeComments": "true",
    "esModuleInterop": true,
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}
